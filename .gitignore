# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/

# venv
.venv/
venv/

# tldextract on-disk PSL cache (we run offline, but just in case)
.tld_set*
.suffix_cache/

# editors
.vscode/
.idea/
*.swp

# --- Layer 3 artifacts (regenerated by training; not committed) ---
models/*.joblib
models/*.pkl
models/training_metadata.json
reports/*.csv
reports/*.json
reports/*.png

# Layer 2 DNS/WHOIS cache + Layer 4 page-analysis cache + RDAP bootstrap
# (all regenerable, machine/time specific, and the page cache can contain
# hashes of URLs that were analysed - never commit it)
data/processed/*.sqlite
data/processed/*.sqlite-*
data/processed/rdap_bootstrap.json

# never commit secrets or local env overrides
.env
.env.*
*.key
*.pem
data/processed/service_token
*service_token*


# raw datasets: never commit downloaded PhishTank/OpenPhish/Tranco/Majestic dumps
data/raw/*
!data/raw/.gitkeep
!data/raw/sample/
data/raw/sample/*
!data/raw/sample/.gitkeep

# keep the committed feature schema (models/feature_schema.json) tracked
!models/feature_schema.json
!models/.gitkeep
!reports/.gitkeep
!data/processed/.gitkeep
